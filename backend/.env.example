DJANGO_SECRET_KEY=change-me
# Production: dat False. De trong/True chi dung khi phat trien cuc bo.
DJANGO_DEBUG=True
# Production (Render): ten host duoc Render cap, vd training-saas-xxxx.onrender.com
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Supabase Postgres connection string (Project Settings > Database > Connection string > URI)
DATABASE_URL=postgresql://postgres:PASSWORD@HOST:5432/postgres

# Origin (co scheme) cua frontend duoc phep goi API - dev: Vite; production: URL Vercel
CORS_ALLOWED_ORIGINS=http://localhost:5173
# Origin (co scheme) duoc tin cay cho CSRF (Django admin) - production: URL Vercel
# vd: CSRF_TRUSTED_ORIGINS=https://training-saas.vercel.app
CSRF_TRUSTED_ORIGINS=

# CLS API (he thong LMS ngoai) - dung cho sync_cls
CLS_SECRET_KEY=your-cls-secret-key
CLS_API_BASE=https://eapiv4.cls.vn/api/HRM
CLS_EXAM_START_DATE=2024-01-01
CLS_PROBATION_EXAM_TYPES=NV,10N,15N,30N
CLS_ONBOARDING_PASS_SCORE=80

# Nguon tuyen dung (CSV export Google Sheet: File > Share > Publish to web > CSV) - dung cho sync_recruitment
RECRUITMENT_SOURCE_CSV_URL=https://docs.google.com/spreadsheets/d/xxx/pub?output=csv

# Kho luu file minh chung/PDF: 'r2' (mac dinh) hoac 'supabase'
STORAGE_BACKEND=r2

# Cloudflare R2 (chuan S3) - lay o dashboard R2: Account ID, ten bucket, Public Development URL,
# va Access Key ID + Secret Access Key (Manage R2 API Tokens > Create Account API token)
R2_ACCOUNT_ID=your-account-id
R2_BUCKET=amg-training-evidence
R2_PUBLIC_BASE_URL=https://pub-xxxxxxxx.r2.dev
R2_ACCESS_KEY_ID=your-access-key-id
R2_SECRET_ACCESS_KEY=your-secret-access-key

# Supabase Storage - GIU DE DU PHONG (dat STORAGE_BACKEND=supabase de dung lai)
# Lay o Supabase Dashboard > Project Settings > API (Project URL + service_role key)
SUPABASE_URL=https://xxxxx.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key
SUPABASE_STORAGE_BUCKET=training-evidence

# Phu cap/Hoa hong trainer - port CommissionService.gs (gia tri mac dinh)
COMMISSION_AMOUNT=300000
COMMISSION_SKILL_THRESHOLD=85
COMMISSION_EXAM_THRESHOLD=80
COMMISSION_WORKED_DAYS=30
# COMMISSION_RESTAURANT_ALLOWLIST=NH001,NH002
KPI_TARGET_PER_MONTH=3

# Thu viec - port Config.gs PROBATION_S_DAYS/PROBATION_O_DAYS (gia tri mac dinh)
PROBATION_S_DAYS=15
PROBATION_O_DAYS=60
PROBATION_DEADLINE_WARN_DAYS=10

# Bao cao dao tao tuan/thang (reports app) - nguoi nhan email
REPORT_TO=admin@example.com
REPORT_CC=

# CSV "To chuc dao tao" va "Cham dich vu nha hang" - xem reports/metrics_csv.py de biet hop
# dong cot tung sheet. NEN dung endpoint LIVE (khong bi cache tre) thay vi link "Publish to
# web" (.../pub?output=csv, co the cache CDN cua Google tre vai phut/gio):
#   https://docs.google.com/spreadsheets/d/<ID_SHEET>/export?format=csv&gid=<GID>
# (lay ID_SHEET tu URL sheet, GID tu URL tab dang mo; sheet phai chia se "Anyone with the
# link - Viewer"). Code da tu them cache-buster + header no-cache khi goi (xem
# reports/metrics_csv.py::_fetch_csv_dict_rows/_fetch_csv_raw_rows) nhung van nen doi sang
# endpoint export/ o tren de tranh do tre cache goc cua "Publish to web".
TRAINING_DATA_CSV_URL=
SERVICE_AUDIT_CSV_URL=

# Phan tich GPT cho khoi cham dich vu trong bao cao dao tao - de trong = bo qua phan phan tich
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Google Drive/Sheets (service account) - dung cho import_july_data (ETL minh chung/danh gia/
# phieu ket qua thu viec tu Google Drive vao v2.1, xem employees/management/commands/
# import_july_data.py). Can bat Drive API + Sheets API cho project cua service account, va
# chia se Viewer folder Drive + spreadsheet cho email service account do.
# JSON key file cua service account, dan NGUYEN VAN 1 DONG (khong xuong dong) de python-dotenv
# doc dung - vd: {"type":"service_account","project_id":"...", ...}
GOOGLE_SERVICE_ACCOUNT_JSON=
# ID thu muc goc tren Drive (lay tu URL thu muc)
TRAINING_DRIVE_ROOT_FOLDER_ID=
# ID spreadsheet "DB_Dao tao" (lay tu URL spreadsheet) - doc tab position_checklists qua Sheets API
TRAINING_DB_SHEET_ID=
# Tab 'app_employees' (diem/ket qua) KHONG nam trong TRAINING_DB_SHEET_ID - doc rieng qua link
# CSV "Publish to web" cong khai. De trong = dung link mac dinh trong settings.py.
APP_EMPLOYEES_CSV_URL=
